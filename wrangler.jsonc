{
  // driving.7mit: the simulator folder is served as static assets; worker.js answers /api/* (the radio's song search) first
  // and hands everything else to the assets. `previews` is required by `npx wrangler preview` (preview deployments of pull requests).
  "name": "7mit-game-drive-jva",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "assets": { "directory": "./simulator", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "previews": {}
}
